# AlphaESS API credentials (required)
APP_ID=your_alphaess_app_id
APP_SECRET=your_alphaess_app_secret
SERIAL_NUMBER=your_ess_serial_number

# Required for AWS/cloud sign-in. The local LAN dashboard is passwordless.
DASHBOARD_USER=household
DASHBOARD_PASSWORD=
# Optional: use manager.yaml price_source: entsoe
ENTSOE_TOKEN=
# Required for durable state in Lambda; do not use SQLite in /tmp.
DYNAMODB_TABLE=
MANAGER_LIVE=false

# Optional NAS LAN bind; defaults to loopback when not supplied.
NAS_BIND_IP=127.0.0.1

# Optional one-command deployment / Docker configuration
NAS_SSH_HOST=
MANAGER_CONFIG=./manager.local.yaml
SOLAR_CONFIG=./solar.local.yaml
